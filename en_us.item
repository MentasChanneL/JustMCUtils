luckywars-object-ufo_warn = <yellow>⚠ Critical height! ⚠

luckywars-game_queue-header = <shadow:#00000000><font:luckywars:icons>3.3.3.3.3.3.3
luckywars-game_queue-find_players = <shadow:#00000000><white><font:luckywars:game_queue1>Waiting a players...
luckywars-game_queue-creating_game = <shadow:#00000000><white><font:luckywars:game_queue1>Game creation...

luckywars-map-mushrooms-name = Retro mushrooms
luckywars-map-abstract-name = Absttraction

luckywars-game-join = <gray>+ $player
luckywars-game-leave = <dark_gray>- $player
luckywars-game-prepare = <yellow>The game will start in <white>$time <yellow>seconds!
luckywars-game-no_team-message = Remember, every man for himself!
luckywars-game-start = <#FFCF00><font:luckywars:icons>b<font:default> <yellow>The game has begun! <#FFCF00><font:luckywars:icons>b
luckywars-game-start-subtitle = <red>There is only one winner!
luckywars-game-no_players = <#f7f286>Not enough players to start!
luckywars-game-get_ready = <#ee9a62>... Get ready ...
luckywars-game-barrier_event = <gold>⚠ Barrier event ⚠
luckywars-game-barrier_event-message = <#f7f286>The barrier began to shrink!
luckywars-game-destroy_event = <#FF2200>⚠ Annihilation ⚠
luckywars-game-destroy_event-message = <#f7f286>Annihilation! Only one will survive!

luckywars-game-death = <white>$killer <yellow>$icon <red>$victim <#FF0000>☠
luckywars-game-death-title = <#FF2200>☠ <red>Defeat <#FF2200>☠
luckywars-game-death-subtitle = <#FFAA00>You were killed by $killer
luckywars-game-victory = <#FFEF00><font:luckywars:icons>a<font:default> <yellow>Victory <#FFEF00><font:luckywars:icons>a
luckywars-death-stats = Stats: <yellow>$placest <white>place, <red>$kills <white>kills
luckywars-top-top = <yellow>┌─ ʟᴜᴄᴋʏ ᴡᴀʀꜱ
luckywars-top-element = <yellow>│<$color> #$placest <white>$player [<red>$kills 🗡<white>]
luckywars-top-bottom = <yellow>└────────────

luckywars-tab-feet [
 <white>
 <gray> ─<font:s><tr:s.-1><font:default>─ <gold>TPS: <white>$tps <gold>Ping: <white>$ping <gray>─<font:s><tr:s.-1><font:default>─
 <white>
]

luckywars-commands-cd = <red>Please wait a moment.
luckywars-commands-leave-fail = <red>You are not in the game!
luckywars-commands-play-fail = <red>You already in game!
luckywars-protocol_warning = <#f7f286>We recommend playing on 1.21.8.

luckywars-platform-item-profile = <font:luckywars:name_usaly>&+[PROFILE&+]
end